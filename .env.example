# Copy to .env and fill in. Never commit .env.

# Gong: Company Settings -> Ecosystem -> API (needs a Gong admin).
GONG_ACCESS_KEY=
GONG_ACCESS_SECRET=
# Some Gong workspaces use their own API host; Gong shows it next to the key.
GONG_BASE_URL=https://api.gong.io

# Airtable: personal access token limited to one base, with scopes
# data.records:read, data.records:write, and (for --setup) schema.bases:read,
# schema.bases:write. Base ID starts with "app" (see the base URL).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Calls
